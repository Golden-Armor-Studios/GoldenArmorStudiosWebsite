rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasGroup(group) {
      return request.auth != null
        && request.auth.token.groups is list
        && group in request.auth.token.groups;
    }

    function isAdmin() {
      return hasGroup('admin');
    }

    match /News/{allPaths=**} {
      allow read;  // public news assets
      allow write: if isAdmin();
    }

    match /editor/{allPaths=**} {
      allow read;  // editor uploads and previews
      allow write: if isAdmin();
    }

    match /cover-final/{allPaths=**} {
      allow read;  // published cover images
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
